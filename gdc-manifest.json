{
  "$schema": "https://gdc.internal/schemas/plugin-manifest-v1.json",
  "name": "MediaFlow Monitor",
  "publisher": "GDC",
  "version": "1.8.0",
  "description": "Utilitar nativ ultra-lightweight pentru monitorizare RAM/Swap \u0219i DaVinci Resolve log watcher.",
  "category": "utility",
  "platforms": {
    "macos": {
      "executable": "Build/macOS/MediaFlowMonitor.app",
      "minOSVersion": "13.0",
      "signed": true,
      "notarized": true
    },
    "windows": {
      "executable": "Publish/Windows/MediaFlowMonitor.exe",
      "minOSVersion": "10.0.17763.0",
      "signed": false
    }
  },
  "icon": {
    "png256": "Resources/GDC/gdc-icon.png",
    "ico": "Resources/GDC/gdc-icon.ico"
  },
  "shortcuts": {
    "macos": "Cmd+Shift+M",
    "windows": "Ctrl+Shift+M"
  },
  "localization": [
    "en",
    "ro",
    "es"
  ],
  "buildStage": "public-beta",
  "release": {
    "channel": "public-beta",
    "checkIntervalHours": 12,
    "updateManifestPath": "dist/version-manifest.json"
  }
}
