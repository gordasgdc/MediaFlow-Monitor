<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SWITCH la WPF (2026-08-26): WinUI3/WindowsAppSDK produsese o
         serie de crash-uri native netratabile din C# (bootstrap WinRT
         esuat, cod 0xc0000409, inainte sa ruleze orice linie din codul
         nostru) pe Windows ARM64 (Parallels pe Apple Silicon). WPF ruleaza
         pe .NET simplu, fara MSIX/PRI/bootstrap WinRT, testat si stabil
         de ani de zile prin `dotnet publish` simplu. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Permite dotnet restore/build sa rezolve TFM-ul windows si de pe
         macOS (vezi acelasi comentariu in GDCVaultWin/GDCPluginManagerWin)
         - util pentru verificare sintactica locala; NU inlocuieste un
         build real pe Windows (XAML->BAML) - fara CI Windows, verificarea
         ramane manuala/vizuala inainte de orice release. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Versiune Windows independentă de cea de pe Mac (fiecare platformă
         are propriul câmp în dist/version-manifest.json) — bump manual la
         fiecare release, sincron cu Windows/installer.iss (Regula 14). -->
    <Version>1.9.1</Version>
    <RootNamespace>MediaFlowMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <!-- Doar pentru NotifyIcon (tray icon) - WPF nu are un echivalent
         nativ, System.Windows.Forms.NotifyIcon e standardul folosit de
         orice app WPF care are nevoie de iconita in system tray. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- WFAC010: analizatorul WinForms recomanda ApplicationHighDpiMode in
         locul DPI din manifest - dar asta e o app WPF (WinForms doar pentru
         NotifyIcon), iar declararea PerMonitorV2 prin manifest ramane
         metoda CORECTA si necesara pentru ferestrele WPF. Suprimat explicit
         (nu eliminam DPI-ul din manifest, ar strica scalarea Dashboard-ului
         pe monitoare cu DPI diferit). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Regula 17: versiuni fixate explicit, fără range/wildcards -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- PerformanceCounter a fost scos din .NET Core/5+ in namespace-ul de
         baza si mutat intr-un pachet separat (forwarded type). -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <!-- Ed25519 pentru verificarea licentelor (LicenseCore.cs) - .NET nu
         expune Ed25519 nativ pe Windows (CNG nu il suporta), BouncyCastle
         e pur managed, cross-platform, standard pentru acest caz. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <!-- BUG FIX (2026-08-26): UseWindowsForms=true + ImplicitUsings=enable
       adauga automat "System.Windows.Forms" si "System.Drawing" ca global
       usings, care intra in conflict cu tipurile WPF cu acelasi nume
       (Timer, Brush/Brushes, Application, Rectangle) - eroare CS0104
       "ambiguous reference" pe orice fisier care nu le calificase deja
       explicit. Codul existent a fost si el calificat explicit (belt-and-
       suspenders), dar radacina reala e aici: scoatem cele doua usings
       implicite, ca System.Windows.Forms/System.Drawing sa ramana
       accesibile doar prin `using` explicit sau nume complet calificat. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
