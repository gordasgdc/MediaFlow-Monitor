    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D22"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6068"/>
