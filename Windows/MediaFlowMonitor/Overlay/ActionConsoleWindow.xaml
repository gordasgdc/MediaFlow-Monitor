<Window x:Class="MediaFlowMonitor.Overlay.ActionConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MediaFlowMonitor"
        Title="Execuție live" Width="560" Height="400"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:ActionLogLevelToBrushConverter x:Key="ActionLevelToBrush"/>
        <local:RunningActionToStatusBrushConverter x:Key="RunningToStatusBrush"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Ellipse Width="9" Height="9" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{Binding RunningAction, Converter={StaticResource RunningToStatusBrush}}"/>
            <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#D8000000" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ActionLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,2"
                                       Foreground="{Binding Level, Converter={StaticResource ActionLevelToBrush}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="Închide" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,6"
                Click="OnCloseClicked" x:Name="CloseButton"/>
    </Grid>
</Window>
