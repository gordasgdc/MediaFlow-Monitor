<Window x:Class="MediaFlowMonitor.Overlay.ConfirmActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmare" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText"
                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock x:Name="BodyText" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        <CheckBox x:Name="SuppressCheck" Margin="0,14,0,0" Visibility="Collapsed"
                  Foreground="{DynamicResource TextSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Anulează" Padding="14,6" Margin="0,0,8,0" Click="OnCancel" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Padding="14,6" Click="OnConfirm" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
