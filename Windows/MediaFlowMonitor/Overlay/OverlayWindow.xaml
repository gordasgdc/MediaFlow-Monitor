<Window x:Class="MediaFlowMonitor.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MediaFlowMonitor"
        Title="MediaFlow Monitor"
        Width="900" Height="760"
        MinWidth="800" MinHeight="650"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Visibility="Collapsed">
    <Window.Resources>
        <local:MetricLevelToBrushConverter x:Key="LevelToBrush"/>
        <local:ThermalStateToBrushConverter x:Key="ThermalToBrush"/>
        <local:NullableBoolToHealthTextConverter x:Key="HealthText"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:RunningActionEqualsConverter x:Key="ActionEquals"/>
        <local:RunningActionToBoolInverseConverter x:Key="ActionIdle"/>
        <local:ActionButtonTextConverter x:Key="ActionButtonText"/>
        <local:LogFilterToBackgroundConverter x:Key="LogFilterBg"/>
        <local:BoolToPauseGlyphConverter x:Key="PauseGlyph"/>
        <local:LogLineFormatConverter x:Key="LogLineFormat"/>
        <local:TextContainsKeywordToBoldConverter x:Key="KeywordBold"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HeadlineStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CaptionStyle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- Top bar: titlu + selector temă -->
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="MediaFlow Monitor" Style="{StaticResource HeadlineStyle}" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <TextBlock Text="Temă" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="ThemeSystemRadio" Content="Sistem" GroupName="Theme" Margin="0,0,6,0" Checked="OnThemeRadioChecked" Tag="System"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Theme" Margin="0,0,6,0" Checked="OnThemeRadioChecked" Tag="Light"/>
                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Theme" Checked="OnThemeRadioChecked" Tag="Dark"/>
                    </StackPanel>
                </DockPanel>

                <!-- System Health -->
                <WrapPanel>
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="System Health" Style="{StaticResource HeadlineStyle}"/>
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                         Fill="{Binding OverallLevel, Converter={StaticResource LevelToBrush}}"/>
                            </DockPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM" Style="{StaticResource CaptionStyle}" Width="40" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="1" Margin="8,0"
                                             Value="{Binding RamFraction, Mode=OneWay}" VerticalAlignment="Center"
                                             Foreground="{Binding RamLevel, Converter={StaticResource LevelToBrush}}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                           Text="{Binding RamFraction, StringFormat={}{0:P0}}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Swap" Style="{StaticResource CaptionStyle}" Width="40" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="1" Margin="8,0"
                                             Value="{Binding SwapFraction, Mode=OneWay}" VerticalAlignment="Center"
                                             Foreground="{Binding SwapLevel, Converter={StaticResource LevelToBrush}}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                           Text="{Binding SwapFraction, StringFormat={}{0:P0}}"/>
                            </Grid>

                            <!-- Top RAM Consumers / Top Swap Consumers -->
                            <Separator Margin="0,10,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Top RAM Consumers" FontSize="10" Style="{StaticResource CaptionStyle}"/>
                                    <ItemsControl ItemsSource="{Binding TopRamProcesses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="10" Style="{StaticResource CaptionStyle}"
                                                               Text="{Binding ValueGB, StringFormat={}{0:F1} GB}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Top Swap Consumers" FontSize="10" Style="{StaticResource CaptionStyle}"/>
                                    <ItemsControl ItemsSource="{Binding TopSwapProcesses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="10" Style="{StaticResource CaptionStyle}"
                                                               Text="{Binding ValueGB, StringFormat={}{0:F1} GB}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="System Health" Style="{StaticResource HeadlineStyle}"/>
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                         Fill="{Binding OverallLevel, Converter={StaticResource LevelToBrush}}"/>
                            </DockPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VRAM" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock x:Name="VramText" Grid.Column="1" Style="{StaticResource CaptionStyle}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GPU" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock x:Name="GpuText" Grid.Column="1" Style="{StaticResource CaptionStyle}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Thermal" Style="{StaticResource CaptionStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding ThermalState, Converter={StaticResource ThermalToBrush}}"/>
                                    <TextBlock x:Name="ThermalText" Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Partition" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock x:Name="PartitionText" Grid.Column="1" Style="{StaticResource CaptionStyle}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CacheClip disk" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock x:Name="CacheClipFreeText" Grid.Column="1" Style="{StaticResource CaptionStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Grafice live -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="DaVinci Resolve — Real-time Performance &amp; Log Stream" Style="{StaticResource HeadlineStyle}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Width="380" Margin="0,0,14,0">
                                <TextBlock Text="VRAM / Swap Utilization (MB)" Style="{StaticResource CaptionStyle}"/>
                                <Border Height="130" Margin="0,4,0,0" ClipToBounds="True">
                                    <Canvas x:Name="PerformanceCanvas" SizeChanged="OnPerformanceCanvasSizeChanged"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Width="380">
                                <TextBlock x:Name="CpuHeaderText" Text="CPU Thread 1–N" Style="{StaticResource CaptionStyle}"/>
                                <Border Height="130" Margin="0,4,0,0" ClipToBounds="True">
                                    <ItemsControl x:Name="CpuBarsControl" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <StackPanel Width="380">
                                <TextBlock Text="GPU Utilization (%)" Style="{StaticResource CaptionStyle}"/>
                                <Border Height="130" Margin="0,4,0,0" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock x:Name="GpuUnavailableText" Text="Necunoscut pe acest PC"
                                                   Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Canvas x:Name="GpuCanvas" SizeChanged="OnGpuCanvasSizeChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Log decoder + Recomandări -->
                <WrapPanel>
                    <Border Style="{StaticResource CardStyle}" Width="440">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Real-time Log Decoder" Style="{StaticResource HeadlineStyle}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="⤓" Width="24" Click="OnExportLogClicked" ToolTip="Export Log..."/>
                                    <Button Content="{Binding IsLogPaused, Converter={StaticResource PauseGlyph}}"
                                            Width="24" Click="OnTogglePauseLogClicked" ToolTip="Pause/Resume Auto-scroll"/>
                                    <Button Content="⟳" Width="24" Click="OnForceSyncClicked"
                                            IsEnabled="{Binding RunningAction, Converter={StaticResource ActionIdle}}"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="All" Tag="All" Click="OnLogFilterClicked" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                        Background="{Binding LogFilter, Converter={StaticResource LogFilterBg}, ConverterParameter=All}"/>
                                <Button Tag="Errors" Click="OnLogFilterClicked" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                        Background="{Binding LogFilter, Converter={StaticResource LogFilterBg}, ConverterParameter=Errors}"
                                        Content="{Binding ErrorCount, StringFormat=Errors ({0})}"/>
                                <Button Tag="Warnings" Click="OnLogFilterClicked" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                        Background="{Binding LogFilter, Converter={StaticResource LogFilterBg}, ConverterParameter=Warnings}"
                                        Content="{Binding WarningCount, StringFormat=Warnings ({0})}"/>
                                <Button Content="Render Events" Tag="RenderEvents" Click="OnLogFilterClicked" Padding="6,2" FontSize="10"
                                        Background="{Binding LogFilter, Converter={StaticResource LogFilterBg}, ConverterParameter=RenderEvents}"/>
                            </StackPanel>
                            <ScrollViewer Height="160" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogConsole}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,0,0,2"
                                                       Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LogLineFormat}">
                                                        <Binding Path="Date"/>
                                                        <Binding Path="Text"/>
                                                        <Binding Path="Level"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                                <TextBlock.FontWeight>
                                                    <Binding Path="Text" Converter="{StaticResource KeywordBold}"/>
                                                </TextBlock.FontWeight>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Text="Potential Issues &amp; Recommendations" Style="{StaticResource HeadlineStyle}"/>
                            <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,4,6,0"
                                                     Fill="{Binding Level, Converter={StaticResource LevelToBrush}}"/>
                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="270"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- CacheClip disk -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="CacheClip disk" Style="{StaticResource HeadlineStyle}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="📁" Width="26" Click="OnOpenCacheFolderClicked" ToolTip="Open Cache Folder in Explorer"
                                        Background="Transparent" BorderThickness="0"/>
                                <Button Content="Schimbă folderul…" Click="OnChooseFolderClicked"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="CacheDiskUsageBar" Height="8" Margin="0,10,0,8" Minimum="0" Maximum="1"/>
                        <DockPanel>
                            <TextBlock x:Name="CacheDiskUsageText" Style="{StaticResource CaptionStyle}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Partition Health: " Style="{StaticResource CaptionStyle}"/>
                                <TextBlock x:Name="CacheDiskHealthText" Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="CacheDiskPathText" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Action bar -->
                <WrapPanel Margin="0,0,0,4">
                    <Button Margin="0,0,10,10" Padding="12,7" Click="OnPurgeCacheClicked"
                            IsEnabled="{Binding RunningAction, Converter={StaticResource ActionIdle}}"
                            Content="{Binding RunningAction, Converter={StaticResource ActionButtonText}, ConverterParameter='PurgeCache|Purge Cache|Purging…'}"/>
                    <Button Margin="0,0,10,10" Padding="12,7" Click="OnForceSyncClicked"
                            IsEnabled="{Binding RunningAction, Converter={StaticResource ActionIdle}}"
                            Content="{Binding RunningAction, Converter={StaticResource ActionButtonText}, ConverterParameter='ForceSyncLog|Force Sync Log|Syncing…'}"/>
                    <Button Margin="0,0,10,10" Padding="12,7" Click="OnOptimiseClicked"
                            IsEnabled="{Binding RunningAction, Converter={StaticResource ActionIdle}}"
                            Content="{Binding RunningAction, Converter={StaticResource ActionButtonText}, ConverterParameter='OptimiseSystem|Optimise System|Optimising…'}"/>
                    <Button Margin="0,0,10,10" Padding="12,7" Content="Copy Diagnostics" Click="OnCopyDiagnosticsClicked"/>
                    <Button Margin="0,0,10,10" Padding="12,7" Click="OnForceCloseDaVinciClicked"
                            Visibility="{Binding HangingDaVinciDetected, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding RunningAction, Converter={StaticResource ActionIdle}}"
                            Foreground="IndianRed"
                            Content="{Binding RunningAction, Converter={StaticResource ActionButtonText}, ConverterParameter='ForceKillDaVinci|Force Close Hanging DaVinci|Closing…'}"/>
                    <Button Margin="0,0,10,10" Padding="12,7" Content="Vezi log"
                            Visibility="{Binding ShowActionConsole, Converter={StaticResource BoolToVis}}"
                            Click="OnShowConsoleClicked" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="LastActionMessageText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <Button Margin="0,0,0,10" Padding="12,7" Content="Close Panel" Click="OnCloseClicked" HorizontalAlignment="Right"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border x:Name="ToastBorder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" CornerRadius="16" Padding="12,8" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="ToastText" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
    </Grid>
</Window>
