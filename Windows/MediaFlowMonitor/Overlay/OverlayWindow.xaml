<Window x:Class="MediaFlowMonitor.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaFlow Monitor"
        Width="280" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="#F014161A"
        Visibility="Collapsed">
    <Window.Resources>
        <SolidColorBrush x:Key="Ok" Color="#3DDC84"/>
        <SolidColorBrush x:Key="Warn" Color="#FFD166"/>
        <SolidColorBrush x:Key="Crit" Color="#EF5350"/>
        <SolidColorBrush x:Key="TextDim" Color="#9AA1A9"/>
    </Window.Resources>

    <Border Padding="16" CornerRadius="12" BorderBrush="#2A2E35" BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <TextBlock Text="MediaFlow Monitor" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" HorizontalAlignment="Right" Fill="{StaticResource Ok}"/>
            </Grid>

            <!-- RAM -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="RAM" Foreground="White" VerticalAlignment="Center" Width="40"/>
                <ProgressBar x:Name="RamBar" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="RamPercentText" Grid.Column="2" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Swap -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Swap" Foreground="White" VerticalAlignment="Center" Width="40"/>
                <ProgressBar x:Name="SwapBar" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SwapPercentText" Grid.Column="2" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Alerts list -->
            <StackPanel x:Name="AlertsPanel" Margin="0,4,0,0"/>

            <!-- Action button -->
            <Button x:Name="ActionButton" Margin="0,10,0,0" Padding="8,6"
                    HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnActionClicked"/>
        </StackPanel>
    </Border>
</Window>
