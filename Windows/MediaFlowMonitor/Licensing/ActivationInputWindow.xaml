<Window x:Class="MediaFlowMonitor.Licensing.ActivationInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Introdu codul de activare" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Introdu codul de activare"
                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
        <TextBlock Text="Codul primit pe WhatsApp după donație (format Base32)."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBox x:Name="CodeTextBox" Padding="6" FontFamily="Consolas"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Anulează" Padding="12,6" Margin="0,0,8,0" Click="OnCancelClicked" IsCancel="True"/>
            <Button Content="Activează" Padding="12,6" Click="OnActivateClicked" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
